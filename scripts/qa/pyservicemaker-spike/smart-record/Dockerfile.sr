FROM nvcr.io/nvidia/deepstream@sha256:f6fa0247da9290979cbb05749e7da9435d089c93db7c4dcfe85ba2488b5f4994
# PyGObject for the raw action-signal harness; onnxruntime (CPU) for the co-resident fall
# model. Deliberately no Torch: the media-plane process must not carry a second CUDA user.
RUN apt-get update -qq && apt-get install -y -qq python3-gi gir1.2-gstreamer-1.0 && rm -rf /var/lib/apt/lists/* \
 && pip install --quiet pyyaml onnxruntime
