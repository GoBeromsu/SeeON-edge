{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seeon.example/contracts/model-selection.schema.json",
  "title": "Desired model selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_publication", "bundle_members_digest", "dataset_publication", "evaluation_receipt_digest", "field_evaluation_receipt_digest", "calibration_digest", "conformance_digest", "input_observation_schema", "output_class_count", "output_class_semantics_digest", "policy_digest", "runtime_format"],
  "properties": {
    "schema_version": {"const": 1},
    "model_publication": {"$ref": "#/$defs/modelPublication"},
    "bundle_members_digest": {"$ref": "#/$defs/digest"},
    "dataset_publication": {"$ref": "#/$defs/datasetPublication"},
    "evaluation_receipt_digest": {"$ref": "#/$defs/digest"},
    "field_evaluation_receipt_digest": {"$ref": "#/$defs/digest"},
    "calibration_digest": {"$ref": "#/$defs/digest"},
    "conformance_digest": {"$ref": "#/$defs/digest"},
    "input_observation_schema": {"type": "string", "minLength": 1},
    "output_class_count": {"type": "integer", "minimum": 1},
    "output_class_semantics_digest": {"$ref": "#/$defs/digest"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "runtime_format": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "datasetPublication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_locator", "revision", "payload_digest"],
      "properties": {
        "source_locator": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "payload_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "modelPublication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_locator", "revision", "bundle_sha256"],
      "properties": {
        "source_locator": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "bundle_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
