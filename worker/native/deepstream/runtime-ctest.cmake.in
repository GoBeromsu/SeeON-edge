  seeon-deepstream-wire-cross-language-test
  "/usr/bin/python3"
  "data/perception_wire_cross_language_test.py"
  "bin/seeon-deepstream-ipc-test"
)
add_test(seeon-deepstream-source-runtime-test "bin/seeon-deepstream-source-runtime-test")
add_test(
  seeon-deepstream-source-runtime-gstreamer-test
  "bin/seeon-deepstream-source-runtime-gstreamer-test"
)
add_test(seeon-deepstream-child-commands-test "bin/seeon-deepstream-child-commands-test")
add_test(seeon-deepstream-au-parser-test "bin/seeon-deepstream-au-parser-test")
add_test(seeon-deepstream-au-transport-test "bin/seeon-deepstream-au-transport-test")
add_test(seeon-deepstream-workspace-pool-test "bin/seeon-deepstream-workspace-pool-test")
