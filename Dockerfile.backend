# syntax=docker/dockerfile:1.7
FROM node:20-bookworm-slim AS front-build

WORKDIR /src/front
RUN corepack enable
COPY front/package.json front/pnpm-lock.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm i --frozen-lockfile
COPY front ./
ARG VITE_ML_API_BASE_URL=/api/v1
RUN pnpm build


FROM ghcr.io/astral-sh/uv:python3.11-trixie-slim@sha256:db19415bf8723d84c0c3f6aabe30929b15fac5027977d1e8e50c6882e017434f

ENV UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:${PATH}"

WORKDIR /app

# Debian's interpreter on this image ships SQLite 3.46.1. Official uv CPython
# 3.11.16 packages 3.53.1, which clears the WAL-reset floor (3.51.3).
RUN --mount=type=cache,target=/root/.cache/uv \
    UV_PYTHON_DOWNLOADS=automatic uv python install 3.11.16 \
 && "$(uv python find 3.11.16)" -c "import sqlite3; print(sqlite3.sqlite_version); assert sqlite3.sqlite_version_info >= (3, 51, 3)"

COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-default-groups --no-install-project --python "$(uv python find 3.11.16)" \
 && python -c "import sqlite3; print(sqlite3.sqlite_version); assert sqlite3.sqlite_version_info >= (3, 51, 3)"

COPY contracts ./contracts
COPY shared ./shared
COPY backend ./backend
COPY scripts/ops ./scripts/ops
COPY --from=front-build /src/front/dist /app/front
RUN mkdir -p /app/models/fall /app/models/pose /app/models/bed
# State dir is image-owned (matches backend/app/shared/state_dir.py's resolver
# for the root container user); deliberately no VOLUME here to avoid
# anonymous-volume sprawl and derived-image RUN neutralization —
# compose.edge.yaml attaches a named volume at this same path instead.
RUN mkdir -p /root/.local/state/ml-api

ARG EDGE_DATABASE_SCHEMA_VERSION=18
RUN install -d -m 0755 /opt/seeon \
    && printf '%s\n' "${EDGE_DATABASE_SCHEMA_VERSION}" > /opt/seeon/edge-database-schema-version \
    && chmod 0444 /opt/seeon/edge-database-schema-version

ARG SOURCE_REVISION=0000000000000000000000000000000000000000
RUN if [ "${#SOURCE_REVISION}" -ne 40 ] || printf '%s' "$SOURCE_REVISION" | grep -Eq '[^0123456789abcdef]'; then \
      printf '%s\n' 'SOURCE_REVISION must be exactly 40 lowercase hexadecimal characters' >&2; \
      exit 1; \
    fi
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.source="SeniorAILab/eldercare-fall-ml-v2" \
      seeon.edge.database.schema-version="${EDGE_DATABASE_SCHEMA_VERSION}"

ENV HOST=127.0.0.1 \
    PORT=8000
EXPOSE 8000
CMD ["sh", "-c", "uvicorn backend.app.main:app --host ${HOST} --port ${PORT}"]
