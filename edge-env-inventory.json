    },
    {
      "name": "ML_RTSP_ALLOW_PRIVATE_DESTINATIONS",
      "category": "deployment artifact",
      "authority": "deployment env",
      "behavior": "0|1; facility LAN RFC1918/CGNAT cameras require 1; projected to ml-api and ml-worker",
      "compose": true,
      "example": true,
      "service_environment": true
    },
    {
      "name": "ML_RTSP_ALLOW_LOCAL_DESTINATIONS",
      "category": "deployment artifact",
      "authority": "deployment env",
      "behavior": "0|1; loopback/link-local fixture contract only; production must stay 0; projected to ml-api and ml-worker",
      "compose": true,
      "example": true,
      "service_environment": true
    }
  ]
}
