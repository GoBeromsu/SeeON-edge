      "behavior": "retired; worker startup rejects injection"
    },
    {
      "name": "ML_WORKER_FALL_MODEL_ARTIFACT_DIR",
      "category": "mutable policy",
      "authority": "versioned model config with fixed /app/models root",
      "behavior": "retired; worker startup rejects injection"
    },
    {
      "name": "ML_WORKER_FALL_MODEL_WINDOW",
      "category": "mutable policy",
      "authority": "versioned model config/artifact manifest",
      "behavior": "retired; worker startup rejects injection"
    },
    {
      "name": "ML_WORKER_FALL_MODEL_STRIDE",
