    },
    {
      "name": "API_CAMERA_INVENTORY",
      "category": "dead",
      "authority": "camera_registry DB/dashboard",
      "behavior": "retired roster key; backend startup rejects injection"
    },
    {
      "name": "EDGE_CAMERA_CONFIG",
      "category": "dead",
      "authority": "camera_registry DB/dashboard",
      "behavior": "retired static roster key; worker startup rejects injection"
    },
    {
      "name": "EDGE_CAMERA_CONFIG_FILE",
      "category": "dead",
