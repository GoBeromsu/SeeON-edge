    },
    {
      "name": "ML_WORKER_FALL_MODEL_TYPE",
      "category": "mutable policy",
      "authority": "versioned model config",
      "behavior": "retired; worker startup rejects injection"
    },
    {
      "name": "ML_WORKER_FALL_MODEL_WEIGHTS",
      "category": "mutable policy",
      "authority": "versioned model config",
      "behavior": "retired; worker startup rejects injection"
    },
    {
      "name": "ML_WORKER_FALL_MODEL_ARCHITECTURE",
      "category": "mutable policy",
