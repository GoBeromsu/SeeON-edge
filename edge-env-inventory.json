      "behavior": "retired; worker startup rejects injection"
    },
    {
      "name": "API_ALLOW_LEGACY_DASHBOARD_AUTH",
      "category": "legacy compatibility",
      "authority": "server-issued dashboard session cookie",
      "behavior": "retired; backend startup rejects injection"
    },
    {
      "name": "API_BACKEND_EVENTS_URL",
      "category": "legacy compatibility",
      "authority": "API_BACKEND_BASE_URL",
      "behavior": "retired; backend startup rejects injection; migrate the common origin to API_BACKEND_BASE_URL"
    },
    {
      "name": "API_BACKEND_CONFIG_URL",
      "category": "legacy compatibility",
      "authority": "API_BACKEND_BASE_URL",
      "behavior": "retired; backend startup rejects injection; migrate the common origin to API_BACKEND_BASE_URL"
    },
    {
      "name": "API_FACILITY_ID",
      "category": "dead",
      "authority": "connection settings DB enrollment",
      "behavior": "retired identity key; backend startup rejects injection"
    },
    {
      "name": "EDGE_FACILITY_TOKEN",
      "category": "dead",
