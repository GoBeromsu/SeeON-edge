# syntax=docker/dockerfile:1.7

ARG EDGE_DATABASE_SCHEMA_VERSION=19

# ml-worker is the DeepStream Flow production image. Engines are prepared before
# boot; the worker verifies them and never builds them at runtime (ADR-0002).
FROM nvcr.io/nvidia/deepstream@sha256:f6fa0247da9290979cbb05749e7da9435d089c93db7c4dcfe85ba2488b5f4994 AS parser-build
COPY worker/adapters/deepstream/native_parser/yolo26_pose_parser.cpp /src/yolo26_pose_parser.cpp
RUN g++ -std=c++17 -shared -fPIC -O2 \
      -o /src/libnvdsinfer_custom_yolo26_pose.so /src/yolo26_pose_parser.cpp \
      -I/opt/nvidia/deepstream/deepstream/sources/includes -I/usr/local/cuda/include \
    && sha256sum /src/libnvdsinfer_custom_yolo26_pose.so

# Isolated observation build of the pinned nvdsinfer sources. This stage is
# usable with --target sdk-observer-build; it is not a runtime worker process
# and does not qualify the final image.
FROM nvcr.io/nvidia/deepstream@sha256:f6fa0247da9290979cbb05749e7da9435d089c93db7c4dcfe85ba2488b5f4994 AS sdk-observer-build
COPY worker/tools/prepare_nvdsinfer_observer.py /src/prepare_nvdsinfer_observer.py
RUN python3 /src/prepare_nvdsinfer_observer.py /src/observer \
    && test -f /src/observer/sources/libs/nvdsinfer/libnvds_infer.so \
    && test -f /src/observer/build-result.json \
    && test -f /src/observer/source-recipe.json \
    && test -f /src/observer/observation.patch \
    && test -f /src/observer/compile.log


# The C ABI libraries the Rust adapter links: TensorRT/CUDA, DeepStream media
# and libav clip decoding. A missing SDK header or library fails the build.
FROM nvcr.io/nvidia/deepstream@sha256:f6fa0247da9290979cbb05749e7da9435d089c93db7c4dcfe85ba2488b5f4994 AS native-build
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libavcodec-dev \
        libavformat-dev \
        libavutil-dev \
        libswscale-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*
COPY worker/adapters/deepstream/native /src/native
RUN make -C /src/native OUT=/opt/seeon/lib all \
    && sha256sum /opt/seeon/lib/libseeon_gpu.so /opt/seeon/lib/libseeon_media.so \
        /opt/seeon/lib/libseeon_clipdec.so

# One validated source declaration for the release binary, image marker, label,
# and runtime environment. This stage is not a shipping image.
FROM nvcr.io/nvidia/deepstream@sha256:f6fa0247da9290979cbb05749e7da9435d089c93db7c4dcfe85ba2488b5f4994 AS source-revision
ARG EDGE_DATABASE_SCHEMA_VERSION
ARG SOURCE_REVISION
RUN if [ "$SOURCE_REVISION" = "0000000000000000000000000000000000000000" ] \
      || [ "${#SOURCE_REVISION}" -ne 40 ] \
      || printf '%s' "$SOURCE_REVISION" | grep -Eq '[^0123456789abcdef]'; then \
      printf '%s\n' 'SOURCE_REVISION must be a non-zero 40-character lowercase hexadecimal revision' >&2; \
      exit 1; \
    fi; \
    install -d -m 0755 /opt/seeon \
    && printf '%s\n' "$SOURCE_REVISION" > /opt/seeon/ml-worker-image-revision \
    && printf '%s\n' "$EDGE_DATABASE_SCHEMA_VERSION" > /opt/seeon/edge-database-schema-version \
    && chmod 0444 /opt/seeon/ml-worker-image-revision /opt/seeon/edge-database-schema-version

# Pin the official Rust 1.90.0 linux/amd64 manifest, as Dockerfile.rust-builder does.
FROM docker.io/library/rust:1.90.0-bookworm@sha256:3f6e6f8d8725a65a2db964bb828850f888d430c68784d661f753144e5d787207 AS rust-toolchain
RUN rustup component add --toolchain 1.90.0 clippy rustfmt

# Links the Rust workspace against the native-build libraries and compiles the
# release binary. CPU tests run in cargo-verify; GPU qualification runs
# separately on a GPU host.
FROM nvcr.io/nvidia/deepstream@sha256:f6fa0247da9290979cbb05749e7da9435d089c93db7c4dcfe85ba2488b5f4994 AS cargo-build
# The clip decoder's test binaries load libav at run time. DeepStream ships no
# libav and strips its codec runtimes; reinstall those as the runtime stage does.
RUN apt-get update \
    && apt-get install -y --reinstall --no-install-recommends \
        libavcodec60 \
        libavformat60 \
        libavutil58 \
        libswscale7 \
        libmp3lame0 \
        libmpg123-0t64 \
        libvpx9 \
        libx264-164 \
        libx265-199 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=rust-toolchain /usr/local/cargo /usr/local/cargo
COPY --from=rust-toolchain /usr/local/rustup /usr/local/rustup
COPY --from=native-build /opt/seeon/lib/ /opt/seeon/lib/
ENV CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:$PATH \
    SEEON_GPU_LIB_DIR=/opt/seeon/lib \
    SEEON_MEDIA_LIB_DIR=/opt/seeon/lib \
    SEEON_CLIPDEC_LIB_DIR=/opt/seeon/lib \
    LD_LIBRARY_PATH=/opt/seeon/lib:/opt/nvidia/deepstream/deepstream/lib:${LD_LIBRARY_PATH}
WORKDIR /usr/src/myapp
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY worker/rust ./worker/rust
COPY worker/runtime/rust ./worker/runtime/rust
COPY worker/adapters/deepstream/rust ./worker/adapters/deepstream/rust
COPY worker/adapters/deepstream/native ./worker/adapters/deepstream/native
COPY worker/bin ./worker/bin
COPY --from=source-revision /opt/seeon/ml-worker-image-revision /tmp/.source-revision
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    test "$(rustc --version)" = "rustc 1.90.0 (1159e78c4 2025-09-14)" \
    && test "$(cargo --version)" = "cargo 1.90.0 (840b83a10 2025-07-30)" \
    && test -s /tmp/.source-revision \
    && build_revision="$(cat /tmp/.source-revision)" \
    && ML_WORKER_BUILD_REVISION="$build_revision" cargo build --locked --release --workspace \
    && test -x target/release/ml-worker \
    && rm -f /tmp/.source-revision

# Explicit verification target. It is not a shipping image and must not be the
# final stage. CPU tests stay undeclared; only the release build above binds
# the validated revision.
FROM cargo-build AS cargo-verify
COPY scripts/prepare_rust_test_inputs.py /usr/src/myapp/scripts/prepare_rust_test_inputs.py
COPY worker/adapters/deepstream/configs /usr/src/myapp/worker/adapters/deepstream/configs
RUN install -d -o 65534 -g 65534 /tmp/seeon-cargo \
    && chown -R 65534:65534 /usr/src/myapp
ENV CARGO_HOME=/tmp/seeon-cargo
USER 65534:65534
RUN --mount=type=secret,id=rust-test-inputs,required=true,uid=65534,gid=65534 \
    --mount=type=cache,id=seeon-rust-verification-registry,target=/tmp/seeon-cargo/registry,uid=65534,gid=65534 \
    python3 /usr/src/myapp/scripts/prepare_rust_test_inputs.py \
      --archive /run/secrets/rust-test-inputs \
    && cargo test --locked --workspace


FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim@sha256:e5b65587bce7de595f299855d7385fe7fca39b8a74baa261ba1b7147afa78e58 AS uv-bin

FROM nvcr.io/nvidia/deepstream@sha256:f6fa0247da9290979cbb05749e7da9435d089c93db7c4dcfe85ba2488b5f4994 AS runtime
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --reinstall --no-install-recommends \
        ffmpeg \
        fonts-noto-cjk \
        intel-media-va-driver-non-free \
        libflac12t64 \
        libmp3lame0 \
        libmpg123-0t64 \
        libvpx9 \
        libx264-164 \
        libx265-199 \
        vainfo \
    && rm -rf /var/lib/apt/lists/*
COPY --from=uv-bin /usr/local/bin/uv /usr/local/bin/uv
COPY --from=parser-build /src/libnvdsinfer_custom_yolo26_pose.so /opt/nvidia/deepstream/deepstream/lib/
COPY --from=sdk-observer-build /src/observer/sources/libs/nvdsinfer/libnvds_infer.so /opt/nvidia/deepstream/deepstream/lib/
COPY --from=sdk-observer-build /src/observer/build-result.json /opt/seeon/nvdsinfer-observer/build-result.json
COPY --from=sdk-observer-build /src/observer/source-recipe.json /opt/seeon/nvdsinfer-observer/source-recipe.json
COPY --from=sdk-observer-build /src/observer/observation.patch /opt/seeon/nvdsinfer-observer/observation.patch
COPY --from=sdk-observer-build /src/observer/compile.log /opt/seeon/nvdsinfer-observer/compile.log
COPY --from=cargo-build /usr/src/myapp/target/release/ml-worker /usr/local/bin/ml-worker
COPY --from=native-build /opt/seeon/lib/libseeon_gpu.so /opt/seeon/lib/libseeon_gpu.so
COPY --from=native-build /opt/seeon/lib/libseeon_media.so /opt/seeon/lib/libseeon_media.so
COPY --from=native-build /opt/seeon/lib/libseeon_clipdec.so /opt/seeon/lib/libseeon_clipdec.so
COPY --from=source-revision /opt/seeon/ml-worker-image-revision /opt/seeon/ml-worker-image-revision
COPY --from=source-revision /opt/seeon/edge-database-schema-version /opt/seeon/edge-database-schema-version

ENV UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH=/app/.venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    GST_PLUGIN_PATH=/opt/nvidia/deepstream/deepstream/lib/gst-plugins \
    LD_LIBRARY_PATH=/opt/seeon/lib:/opt/nvidia/deepstream/deepstream/lib:${LD_LIBRARY_PATH}
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv --system-site-packages /app/.venv \
    && uv sync --frozen --no-default-groups --group flow --no-install-project \
    && python -m pip install --no-cache-dir pyyaml \
    && python -c 'import importlib.util as u; assert u.find_spec("pyservicemaker"), "pyservicemaker not visible from the venv"' \
    && python -c 'import onnxruntime; assert "CPUExecutionProvider" in onnxruntime.get_available_providers()' \
    && ! python -c 'import torch' \
    && ! python -c 'import ultralytics'

COPY contracts ./contracts
COPY shared ./shared
COPY worker ./worker
COPY worker/adapters/deepstream/configs /opt/seeon/deepstream-flow
RUN mkdir -p \
        /root/.local/state/ml-worker \
        /app/models/pose \
        /app/models/bed \
        /var/lib/seeon-state \
        /var/cache/seeon/tensorrt \
        /var/lib/seeon-records

ARG EDGE_DATABASE_SCHEMA_VERSION
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.source="SeniorAILab/eldercare-fall-ml-v2" \
      seeon.edge.database.schema-version="${EDGE_DATABASE_SCHEMA_VERSION}" \
      com.seniorailab.seeon.deepstream.image="nvcr.io/nvidia/deepstream@sha256:f6fa0247da9290979cbb05749e7da9435d089c93db7c4dcfe85ba2488b5f4994" \
      com.seniorailab.seeon.worker.profile="flow"
ENV ML_WORKER_BUILD_REVISION="${SOURCE_REVISION}" \
    ML_WORKER_PROFILE=flow \
    PYTHONPATH=/app
CMD ["python", "-m", "worker"]
