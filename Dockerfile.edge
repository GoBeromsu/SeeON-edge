# syntax=docker/dockerfile:1.7

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

ENV UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:${PATH}"

WORKDIR /app

# ffmpeg is required by the clip recorder for H.264 encoding (h264_nvenc on the
# edge GPU, libx264 fallback). --no-install-recommends keeps the image lean; the
# version probe fails the build early if the binary is missing.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/* \
    && ffmpeg -version \
    && test -f /usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

# Intel VAAPI runtime for the `igpu` profile (decode-only; see
# worker/adapters/decode/vaapi/). `intel-media-va-driver-non-free` is the
# real iHD driver Arrow Lake needs -- the free `intel-media-va-driver`
# package only ships the legacy i965 driver, which does not support Arrow
# Lake's Xe-class iGPU, so non-free is a hard requirement here, not a
# convenience choice. It lives in Debian's non-free component, which the
# base image's sources.list does not enable by default. `libva-drm2` is the
# libva DRM winsys plugin (talks to /dev/dri render nodes); `vainfo` is a
# diagnostic CLI only, for verifying the driver loads at runtime (see
# docs/runbooks/vaapi-igpu-decode.md) -- neither pulls a desktop mesa/GL
# stack. This installs on every profile's image (one shared Dockerfile), the
# same tradeoff already made for ffmpeg above; it does not touch or gate the
# nvdec/opencv/cuda paths.
#
# DO NOT add a second sources.list.d entry for deb.debian.org (e.g. a
# legacy one-line `deb http://deb.debian.org/debian bookworm ...` file).
# This base image ships /etc/apt/sources.list.d/debian.sources in deb822
# format with an explicit `Signed-By:` keyring already pinned. A second
# entry for the *same* repo+suite without a matching Signed-By makes apt
# see two disagreeing values for one source and refuse to read sources at
# all ("E: Conflicting values set for option Signed-By regarding source
# http://deb.debian.org/debian/ bookworm: ... != ..."), failing the build
# before any package install runs. Instead, widen the Components: already
# present on that entry. The sed is scoped to the bookworm/bookworm-updates
# stanza only, so it does not also enable non-free on the bookworm-security
# stanza. If a future base image bump changes this layout, fail loudly here
# instead of a silent no-op that only surfaces later as a confusing
# "package not found" from apt-get install.
RUN set -eux; \
    sed -i '/^Suites: bookworm bookworm-updates$/,/^$/ s/^Components:.*/Components: main contrib non-free non-free-firmware/' \
        /etc/apt/sources.list.d/debian.sources; \
    grep -A5 '^Suites: bookworm bookworm-updates$' /etc/apt/sources.list.d/debian.sources \
        | grep -q '^Components:.*non-free' \
        || { echo "ERROR: failed to enable non-free components on debian.sources -- base image apt sources layout changed, update this RUN" >&2; exit 1; }
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        intel-media-va-driver-non-free \
        libva-drm2 \
        vainfo \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-default-groups --group worker --no-install-project

COPY contracts ./contracts
COPY shared ./shared
COPY worker ./worker
# No operational SQLite CLI ships in this image. ADR 0005 gives the
# inference-runtime slot no database, so clip-consistency repair is
# backend-owned (scripts/ops/repair-clip-consistency.py against
# backend/app/features/clips/consistency_ops.py).
RUN mkdir -p /app/models/fall/lstm-runtime /app/models/pose /app/models/bed
# State dir is image-owned (matches worker/runtime/state_dir.py's resolver for
# the root container user); deliberately no VOLUME here to avoid anonymous-
# volume sprawl and derived-image RUN neutralization — compose.edge.yaml
# attaches a named volume at this same path instead.
RUN mkdir -p /root/.local/state/ml-worker

ARG SOURCE_REVISION
RUN if [ "$SOURCE_REVISION" = "0000000000000000000000000000000000000000" ] \
      || [ "${#SOURCE_REVISION}" -ne 40 ] \
      || printf '%s' "$SOURCE_REVISION" | grep -Eq '[^0123456789abcdef]'; then \
      printf '%s\n' 'SOURCE_REVISION must be a non-zero 40-character lowercase hexadecimal revision' >&2; \
      exit 1; \
    fi; \
    install -d -m 0755 /opt/seeon; \
    printf '%s\n' "$SOURCE_REVISION" > /opt/seeon/ml-worker-image-revision; \
    chmod 0444 /opt/seeon/ml-worker-image-revision
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.source="SeniorAILab/eldercare-fall-ml-v2"
ENV ML_WORKER_BUILD_REVISION="${SOURCE_REVISION}"

CMD ["python", "-m", "worker"]
