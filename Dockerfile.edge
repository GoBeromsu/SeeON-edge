# syntax=docker/dockerfile:1.7

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim@sha256:e5b65587bce7de595f299855d7385fe7fca39b8a74baa261ba1b7147afa78e58 AS uv-bin

FROM nvcr.io/nvidia/deepstream@sha256:f6fa0247da9290979cbb05749e7da9435d089c93db7c4dcfe85ba2488b5f4994 AS runtime

COPY --from=uv-bin /usr/local/bin/uv /usr/local/bin/uv

ENV UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:${PATH}" \
    GST_PLUGIN_PATH=/opt/nvidia/deepstream/deepstream/lib/gst-plugins \
    LD_LIBRARY_PATH="/opt/nvidia/deepstream/deepstream/lib:${LD_LIBRARY_PATH}"

WORKDIR /app

# Keep the shared image's existing clip/font and Intel decode capabilities.
# DeepStream 9.1 is Ubuntu 24.04, so unlike the old Debian base no apt source
# rewriting is needed for the non-free Intel media driver.
# The NGC image retains dpkg records for several codec libraries whose files
# are intentionally pruned. --reinstall restores those exact Noble packages;
# without it Ubuntu ffmpeg links against absent libvpx/lame/x26x objects.
RUN apt-get update \
    && apt-get install -y --reinstall --no-install-recommends \
        ffmpeg \
        fonts-noto-cjk \
        intel-media-va-driver-non-free \
        libflac12t64 \
        libmp3lame0 \
        libmpg123-0t64 \
        libvpx9 \
        libx264-164 \
        libx265-199 \
        vainfo \
    && apt-get purge -y --auto-remove \
        build-essential \
        cpp \
        cpp-13 \
        cuda-crt-13-2 \
        cuda-nvcc-13-2 \
        cuda-tileiras-13-2 \
        g++ \
        g++-13 \
        gcc \
        gcc-13 \
        libtool \
    && rm -rf \
        /opt/nvidia/deepstream/deepstream/sources \
        /var/lib/apt/lists/* \
    && test ! -e /usr/bin/g++ \
    && test ! -d /opt/nvidia/deepstream/deepstream/sources \
    && ffmpeg -version \
    && test -f /usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc \
    && test -f /opt/nvidia/deepstream/deepstream/lib/gst-plugins/libnvdsgst_multistream.so

COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-default-groups --group worker --no-install-project

COPY contracts ./contracts
COPY shared ./shared
COPY worker ./worker
# No operational SQLite CLI ships in this image. ADR 0005 gives the
# inference-runtime slot no database, so clip-consistency repair is
# backend-owned (scripts/ops/repair-clip-consistency.py against
# backend/app/features/clips/consistency_ops.py).
# State dir is image-owned (matches worker/runtime/state_dir.py's resolver for
# the root container user); deliberately no VOLUME here to avoid anonymous-
# volume sprawl and derived-image RUN neutralization -- compose.edge.yaml
# attaches a named volume at this same path instead.
RUN mkdir -p /root/.local/state/ml-worker
RUN mkdir -p \
        /app/models/fall/pose-bbox56-gru \
        /app/models/pose \
        /app/models/bed \
        /var/lib/seeon-state \
        /var/cache/seeon/tensorrt

ARG EDGE_DATABASE_SCHEMA_VERSION=18
ARG SOURCE_REVISION
RUN if [ "$SOURCE_REVISION" = "0000000000000000000000000000000000000000" ] \
      || [ "${#SOURCE_REVISION}" -ne 40 ] \
      || printf '%s' "$SOURCE_REVISION" | grep -Eq '[^0123456789abcdef]'; then \
      printf '%s\n' 'SOURCE_REVISION must be a non-zero 40-character lowercase hexadecimal revision' >&2; \
      exit 1; \
    fi; \
    install -d -m 0755 /opt/seeon; \
    printf '%s\n' "$SOURCE_REVISION" > /opt/seeon/ml-worker-image-revision; \
    printf '%s\n' "$EDGE_DATABASE_SCHEMA_VERSION" > /opt/seeon/edge-database-schema-version; \
    chmod 0444 /opt/seeon/ml-worker-image-revision /opt/seeon/edge-database-schema-version
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.source="SeniorAILab/eldercare-fall-ml-v2" \
      seeon.edge.database.schema-version="${EDGE_DATABASE_SCHEMA_VERSION}" \
      com.seniorailab.seeon.deepstream.image="nvcr.io/nvidia/deepstream@sha256:f6fa0247da9290979cbb05749e7da9435d089c93db7c4dcfe85ba2488b5f4994"
ENV ML_WORKER_BUILD_REVISION="${SOURCE_REVISION}"

CMD ["python", "-m", "worker"]

# --- CI-only boot smoke stage -------------------------------------------------
#
# NOT SHIPPED -- but read the next paragraph before adding anything below it.
#
# THIS IS THE LAST STAGE, AND DOCKER'S DEFAULT TARGET IS THE LAST STAGE. So a
# bare `docker build -f Dockerfile.edge .` builds THIS, not `runtime`, and would
# ship a production image carrying the smoke layer (verified locally: 82 layers
# against runtime's 81, and a different image ID). Every build that produces an
# image anyone keeps therefore names its stage explicitly with
# `--target runtime` / `target: runtime`: the ml-worker step in
# .github/workflows/edge-images.yml, compose.edge.dev.yaml, and the build
# tests/test_public_repository_privacy.py fails any PUSHING build of this file
# that does not pin `target: runtime`, so the registry cannot receive this stage
# by accident. Building `bootsmoke` adds exactly one layer on top of `runtime`
# and never mutates it, so the runtime image is unaffected by this stage's
# existence -- only by which stage a build selects.
#
# Why it exists. A successful build only proves the image assembles; it does not
# prove the interpreter can import the worker's module graph. That is the #195
# httpx incident: the image built fine and the container died at boot with
# ModuleNotFoundError. `--check-config` is the entrypoint's own no-side-effect
# boot path (worker/runtime/AGENTS.md) -- it forces every top-level import in
# worker/__main__.py's module graph to resolve before returning.
#
# Why it is a BUILD STAGE and not a `docker run`. Running the smoke in the
# workflow requires the built image inside the runner's daemon, i.e. `load:
# true`, i.e. the docker-format exporter: on PR run 33156001540 that exporter
# cost 473.7s (125.9s exporting layers + 347.9s sending tarball) plus 244.0s
# importing to docker -- 717.7s, 89% of the 806s image step and 84% of the whole
# 14m14s required check, to enable a 4.4s check. This stage covers the FRESH
# BUILD path -- every pull request and every push to main. A reused or
# release-built digest is instead pulled from the registry and booted by the
# workflow's second smoke step, so that a release seal only ever pins bytes that
# were actually published and booted. As a stage the same command
# runs inside BuildKit against layers it already has, and no exporter runs at
# all.
#
# Why `--network=none`. It turns "this check is side-effect free" from a comment
# into an assertion the build enforces. With no `--config`, worker/__main__.py
# takes the else-branch at line 321: it reads RELAY_TOKEN (line 323), refuses if
# it is unset (lines 331-337), validates only the SHAPE of the baked relay
# endpoint + token via `RelayConfig.model_validate` (lines 338-346), then in the
# `--check-config` branch (line 348) does one READ-ONLY
# `WorkerConfigLkgStore(...).load()` (line 362) and returns
# CLEAN_SHUTDOWN_EXIT_CODE (line 380). No relay pull, no LKG write, no model
# resolution -- `resolve_local_overrides` sits after the return, at line 382.
# If a future edit makes the check reach the network, this stage fails the build
# instead of silently passing. (The same contract is pinned from the Python side
# in tests/test_worker_startup_config_resolution.py.)
#
# The token only has to be well-formed, not reachable: RELAY_URL is retired and
# the endpoint is fixed in-code, so a literal placeholder is the whole input.
FROM runtime AS bootsmoke
RUN --network=none RELAY_TOKEN=ci-boot-smoke-test python -m worker --check-config
