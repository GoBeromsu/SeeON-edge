# Edge ML production environment contract.
#
# Copy this file to .env.edge.prod on the edge device and fill real values:
#   cp .env.edge.prod.example .env.edge.prod
#
# .env.edge.prod is gitignored.
#
# Every variable compose.edge.yaml hard-requires (the `${VAR:?...}` ones) is
# already given a value below -- either a working default or a bracketed
# <placeholder> -- so `docker compose --env-file .env.edge.prod
# -f compose.edge.yaml config` renders without edits. It won't be a CORRECT
# deployment until the <placeholder> values are replaced with real ones
# though. Before `up`, run the preflight check, which renders the config and
# also fails loudly on any <placeholder> left over:
#   scripts/edge-preflight/check-env.sh .env.edge.prod

# Optional host port for the edge-local ml-api loopback binding.
ML_SERVING_PORT=8000

# Internal worker overlay stream used by the dashboard through ml-api
# /api/v1/streams/{camera_id}. This port is compose-internal; do not publish it
# on the host.
ML_WORKER_DEV_MJPEG=true
ML_WORKER_DEV_MJPEG_PORT=8090

# IANA tz for locally-configured detection windows (e.g. bed_exit's night
# window) when no externally-pulled window already carries one -- see
# backend/app/features/cameras/router.py's _resolved_tz. Unset -> UTC, which
# silently shifts an intended-local-time window to the wrong hours for any
# non-UTC facility (issue #206). Set this to the facility's real tz.
ML_API_DETECTION_TZ=Asia/Seoul

# Facility-wide processed FPS for the live camera wall (unset -> worker 5.0
# default). Raising it smooths the view ONLY where the decode path can sustain
# it: on H.265 substreams via CPU (OpenCV) decode, values above ~5 reintroduce
# ref-frame corruption ("Could not find ref with POC"). Leave unset until a
# GPU (nvdec) decode backend lands, or for cheap-to-decode (H.264) cameras.
# ML_DEFAULT_CAMERA_FPS=

# Production Compose pulls prebuilt edge images. Use the digest-pinned refs
# from the Edge ML Images workflow artifact (`edge-ml-image-refs-<sha>`).
# Prefer those refs over mutable tags:
#   ghcr.io/seniorailab/eldercare-fall-ml/ml-api@sha256:<digest>
# Images are linux/amd64 (RTX GPU PC). On the edge PC, authenticate with a
# read-only (read:packages) credential: docker login ghcr.io
ML_API_IMAGE=ghcr.io/seniorailab/eldercare-fall-ml/ml-api:<git-sha>
ML_WORKER_IMAGE=ghcr.io/seniorailab/eldercare-fall-ml/ml-worker:<git-sha>
# Production uses CUDA on the NVIDIA edge GPU.
ML_WORKER_PROFILE=cuda

# Pull-first (default): leave EDGE_CAMERA_CONFIG unset so ml-worker pulls its
# camera roster from ml-api. Only set it to a mounted YAML path as an
# offline-dev escape hatch (and mount the ml-worker-config secret in compose).
# EDGE_CAMERA_CONFIG=./worker/ml-worker.local.yaml
EDGE_CAMERA_CONFIG=

# Fall model config (issues #66/#68): the backend pull only carries fleet-level
# state (relay/domains/cameras), so models.fall is sourced from these edge-local
# env vars instead. ARTIFACT_DIR is the on/off switch -- the container path is
# fixed by ML_MODELS_DIR's mount (see compose.edge.yaml), so this only needs
# the fall/lstm subpath. Leaving ARTIFACT_DIR unset means no fall model is
# configured and the worker refuses to boot (by design -- see #43). Values
# below mirror worker/ml-worker.example.yaml's fall model block.
ML_WORKER_FALL_MODEL_ARTIFACT_DIR=/app/models/fall/lstm
ML_WORKER_FALL_MODEL_WINDOW=30
ML_WORKER_FALL_MODEL_STRIDE=5
ML_WORKER_FALL_MODEL_OPERATING_THRESHOLD=0.5
ML_WORKER_FALL_MODEL_SCHEMA_VERSION=1
ML_WORKER_FALL_MODEL_PREPROCESSING_IDENTITY=legacy-coco17-xyc-frame-normalized-zero-fill-v1

# Evidence clip recording (issue #68): off by default, deliberately -- see the
# clip.enabled doc in worker/ml-worker.example.yaml. Independent of the
# ML_WORKER_EVENT_CLIP_EXPORT_ENABLED gate below (that's the export sender;
# this is whether a recorder exists at all).
ML_WORKER_CLIP_RECORDING_ENABLED=false

# Backend Event API reached by ml-api from the edge device.
API_BACKEND_EVENTS_URL=https://senai.example.com/api/v1/events

# Bearer token ml-api sends to the backend Event API (issue #552). Must match
# the backend's EDGE_FACILITY_TOKEN exactly. Optional during rollout: unset
# preserves the pre-#552 request shape (no Authorization header) — set this
# BEFORE the backend enforces the guard so ingest keeps working across the
# two-host deploy order.
EDGE_FACILITY_TOKEN=

# Shared bearer token for ml-worker -> ml-api relay calls. Use the same value for
# ml-api API_EDGE_RELAY_TOKEN and the worker RELAY_TOKEN injected by Compose
# (both services read this same file, so setting it once here is enough).
# Generate a fresh one per deployment, e.g.: openssl rand -hex 32
API_EDGE_RELAY_TOKEN=<relay-token>

# Browser operators authenticate to ml-api with these credentials. The password
# stays server-side and is exchanged for an HttpOnly session cookie.
#
# compose.edge.yaml requires both of these to be non-empty (unlike the
# application's own fallback -- see below), so they're pre-filled with the
# app's built-in admin/admin default rather than left blank. Change them from
# the dashboard's "계정 설정" (account settings) panel after first login; that
# persisted change always wins over these env values on subsequent boots.
# Precedence (highest wins): credentials changed from the dashboard and
# persisted on this device (the `credentials` table in
# ~/.local/state/ml-api/catalog.sqlite3, not configurable) > this env pair
# (both must be set) > the built-in admin/admin default.
API_DASHBOARD_USERNAME=admin
API_DASHBOARD_PASSWORD=admin
# Emergency migration only; compose intentionally does not pass this flag.
# Setting it to 1 re-enables the old relay-token dashboard API clients.
API_ALLOW_LEGACY_DASHBOARD_AUTH=0

# Backend ML config-read reached by ml-api from the edge device.
# This is the primary source for camera inventory + night window + config_version.
API_BACKEND_CONFIG_URL=https://senai.example.com/api/v1/ml-config
# Get this from the backend's facility record for this site (the dashboard's
# facility admin view, or whoever provisioned the site in the backend DB).
API_FACILITY_ID=<facility-id>

# Optional fallback camera-to-facility/resident binding JSON. Left empty
# (compose default) so it's a true no-op until the backend config pull is
# unavailable. If you do set it, every facility_id inside MUST match
# API_FACILITY_ID above -- a stale example value here mismatched against a
# real API_FACILITY_ID makes every relay runtime-status call 403 with no
# actionable error (see .claude/skills/edge-bringup troubleshooting, #183).
API_CAMERA_INVENTORY=

# Host directory where evidence clips persist on the nursing-home host
# (bind-mounted at the fixed container path /var/lib/clip-store: worker rw, api ro).
# Must exist and be writable by the container user before `up`.
CLIP_STORE_HOST_DIR=/srv/eldercare/clip-store

# ml-api's own clip-export advertising/relay gate. Stays off until backend
# idempotency and clip capability are verified for this deployment.
ML_API_EVENT_CLIP_EXPORT_ENABLED=0
# Despite the name, this is NOT just a clip toggle: it gates the ml-worker
# sender thread that is the only code path posting to
# /api/v1/relay/alerts -- so leaving it at 0 means detected falls are staged
# locally and NEVER delivered anywhere, with no error logged (see #194).
# Default to 1 so a fresh install actually delivers alerts; only set it back
# to 0 if you deliberately want detection-only staging with no delivery.
ML_WORKER_EVENT_CLIP_EXPORT_ENABLED=1
