# Edge production deployment boundary.
# Keep this file limited to durable service configuration. One-shot operator or
# test activation gates must never be persisted here or forwarded into compose.
# Copy to .env.edge.prod, replace placeholders, then run:
#   scripts/edge-preflight/check-env.sh .env.edge.prod
#

# Compose project name. REQUIRED and deliberately not defaulted: Compose would
# otherwise derive it from the checkout directory, and a wrong value binds a
# different (usually empty) edge-state volume. On the live edge node this must
# match the running stack exactly, or a cutover migrates the wrong database.
# Verify with: docker inspect <api-container> \
#   --format '{{index .Config.Labels "com.docker.compose.project"}}'
COMPOSE_PROJECT_NAME=seeon-edge-wt-alert-api

# Machine authority/disposition inventory: edge-env-inventory.json
# Facility identity/token and camera roster are never accepted here. Enroll the
# facility and register cameras in the dashboard; those values live in SQLite.

# Digest-pinned release artifacts from the Edge ML Images workflow.
ML_API_IMAGE=ghcr.io/seniorailab/eldercare-fall-ml/ml-api:<git-sha>
ML_WORKER_IMAGE=ghcr.io/seniorailab/eldercare-fall-ml/ml-worker:<git-sha>

# Canonical profile choices: cpu-host, nvidia-host-bridge, intel-vaapi-host,
# apple-mps-host, nvidia-device-experimental. Legacy cpu/cuda/igpu/mps aliases
# remain accepted. NVIDIA choices require compose.edge.nvidia.yaml.
ML_WORKER_PROFILE=nvidia

# Public Hub base URL and public-network timeout. Event and config endpoints are
# derived from the base; field-specific URL overrides are retired and rejected.
# Must be https:// — cleartext public Hub URLs are rejected by runtime policy
# and edge-preflight/check-env. No baked public IP http fallback.
API_BACKEND_BASE_URL=https://<hub-hostname>
API_BACKEND_INGEST_TIMEOUT_SEC=10

# Browser operator bootstrap credentials. There is NO built-in admin/admin
# authority — supply a deployment-unique random bootstrap pair. Persisted
# dashboard rotation wins after first login. Preflight rejects admin/admin.
# A corrupt credentials store fails closed (no env fallback).
API_DASHBOARD_USERNAME=<random-bootstrap-username>
API_DASHBOARD_PASSWORD=<random-bootstrap-password>

# Internal api/worker relay secret. One external value feeds both runtime names.
# There is NO built-in default — supply a deployment-unique random token.
# Preflight rejects an empty value, the known sample, and weak/placeholder
# values. Generate one, e.g.: openssl rand -hex 32
API_EDGE_RELAY_TOKEN=<random-relay-token>

# RTSP destination policy (ml-api admission + worker probe). Values must be 0 or 1.
# Facility on-LAN cameras (RFC1918/CGNAT) require PRIVATE=1. LOCAL remains a
# fixture-only contract and must stay 0 in production (preflight rejects 1).
ML_RTSP_ALLOW_PRIVATE_DESTINATIONS=1
ML_RTSP_ALLOW_LOCAL_DESTINATIONS=0

# Host evidence root. Container paths are fixed at /var/lib/clip-store.
CLIP_STORE_HOST_DIR=/srv/eldercare/clip-store

# Clip export is a persisted runtime setting in the Edge dashboard. It defaults
# OFF, applies without restarting the worker, and never disables event alerts.
