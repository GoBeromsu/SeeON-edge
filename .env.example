# Local ML runtime defaults. Copy to .env only for operator-specific values.
#
# Issue #133: the worker (`python -m worker`) boots with ZERO env vars set --
# every ML_WORKER_* var below is optional and has a documented default.
# Nothing in this file needs to be uncommented for a local/dev boot; it
# exists so every knob is discoverable in one place. Values are shown
# commented-out at their effective default; uncomment and edit only the ones
# you need to override.
#
# Fall-detector weights are not in this file at all: `model.pt` is a large
# binary artifact and stays gitignored (see .gitignore). Run
# `scripts/fetch-models.sh` once to download the packaged default LSTM model
# before first boot -- the worker fails closed with that exact hint if the
# artifact is missing.

# --- Docker Compose host-side bind mounts ----------------------------------
# Host directory bind-mounted read-only into the container at /app/models
# (see compose.edge.yaml). Not read directly by the Python worker -- the
# worker always resolves model paths relative to its container cwd (/app).
ML_MODELS_DIR=./models

# Optional offline-dev YAML bootstrap: point --config at a static
# camera-roster YAML (see worker/ml-worker.example.yaml) instead of pulling
# live config from ml-api, e.g. `python -m worker --config
# worker/ml-worker.example.yaml`. There is no env var for this any more --
# the camera roster must never be provisionable through the environment
# (compose is tracked in Git), so a static-roster boot is CLI-flag-only.
# Without --config, worker/__main__.py pulls the config from ml-api over
# RELAY_URL/RELAY_TOKEN below, falling back to its own last-known-good cache
# on a pull failure.

# --- Config-pull relay (only used when --config is not passed) ------------
# RELAY_URL=http://ml-api:8000
# RELAY_TOKEN=

# --- Compute/decode/encode profile (worker/runtime/profile) ----------------
# One of cuda|mps|cpu, gating device verification, decode preflight, and
# clip encoder selection. Unset defaults to "cpu" -- the only profile whose
# device check always succeeds without an injected capability probe, so an
# unconfigured boot stays host-independent (passes on any machine, including
# CI) instead of silently depending on whichever GPU happens to be present.
# Real deployments set this explicitly per target (see compose.edge.yaml).
# ML_WORKER_PROFILE=cpu

# --- Fall-detector model (worker/runtime/config/local_env.py) --------------
# Issue #133: ML_WORKER_FALL_MODEL_ARTIFACT_DIR is the on/off switch for
# *explicit* configuration. Unset (the default) resolves to the packaged
# default LSTM model at models/fall/lstm, with window/stride/threshold/
# schema_version/preprocessing_identity all defaulting to that model's own
# manifest values (see models/fall/lstm/metadata.yaml). Once
# ML_WORKER_FALL_MODEL_ARTIFACT_DIR is set explicitly, window/stride/
# operating_threshold become REQUIRED -- a partially-configured fall model
# fails closed at boot (every invalid/missing field reported together, not
# just the first) rather than silently blending with the packaged default.
# ML_WORKER_FALL_MODEL_ARTIFACT_DIR=models/fall/lstm
# ML_WORKER_FALL_MODEL_WINDOW=30
# ML_WORKER_FALL_MODEL_STRIDE=5
# ML_WORKER_FALL_MODEL_OPERATING_THRESHOLD=0.0007872396381571889
# ML_WORKER_FALL_MODEL_SCHEMA_VERSION=1
# ML_WORKER_FALL_MODEL_PREPROCESSING_IDENTITY=legacy-coco17-xyc-frame-normalized-zero-fill-v1

# Model family/architecture (issue #65) -- the registry
# (worker.adapters.model.fall_family_registry) fails closed at boot on an
# unrecognized value. Weights/architecture sidecar filenames rarely need to
# change; they default to model.pt/arch.json (metadata is always
# metadata.yaml, not independently configurable).
# ML_WORKER_FALL_MODEL_TYPE=lstm
# ML_WORKER_FALL_MODEL_WEIGHTS=model.pt
# ML_WORKER_FALL_MODEL_ARCHITECTURE=arch.json

# --- Evidence clip recording -------------------------------------------
# Whether this worker records evidence clips at all. Explicit true/false
# always wins outright; left unset, resolution defers to
# ClipRecordingConfig's own default (worker/runtime/config/worker_models.py)
# instead of forcing false, so a future change to that default takes effect
# on an unconfigured boot.
# ML_WORKER_CLIP_RECORDING_ENABLED=false

# Durable clip export to the relay remains disabled until operators
# explicitly enable rollout. Independent of ML_WORKER_CLIP_RECORDING_ENABLED
# above (that flag controls whether a recorder exists at all; this one
# controls whether staged evidence is shipped out).
# ML_WORKER_EVENT_CLIP_EXPORT_ENABLED=0

# --- Local MJPEG diagnostics server (worker/pipeline/output) ---------------
# ML_WORKER_DEV_MJPEG=false
# ML_WORKER_DEV_MJPEG_HOST=127.0.0.1
# ML_WORKER_DEV_MJPEG_PORT=8090
